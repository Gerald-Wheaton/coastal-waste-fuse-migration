    {
      "id": "build",
      "name": "Build",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1240,
        800
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const j = $('Route').first().json;\nconst endpoint = j.endpoint;\nlet q = {};\ntry { q = JSON.parse(j.query || '{}'); } catch (e) {}\nconst failMode = ($('Get failMode').first().json.failMode || '').toString().trim();\n\nlet statusCode = 200;\nlet responseBody;\n\nif (endpoint === 'token') {\n  if (failMode === 'token') { statusCode = 500; responseBody = { errors: { base: ['Mock /oauth2/token failure'] } }; }\n  else responseBody = { access_token: 'MOCK-TOKEN-COUPA-REFRESHED', token_type: 'bearer', expires_in: 3600, scope: 'core.accounting.read core.purchase_order.read core.requisition.write core.supplier.read core.user.read' };\n} else if (endpoint === 'users') {\n  responseBody = (failMode === 'user') ? [] : [{ id: 1001, login: 'gerald+sm99@fm360consulting.com', email: 'gerald+sm99@fm360consulting.com', active: true }];\n} else if (endpoint === 'addresses') {\n  responseBody = (failMode === 'addr') ? [] : [{ id: 2001, name: 'Coastal Ninety Nine', 'custom-fields': { entity: { 'external-ref-code': 'CWR' }, location: { 'external-ref-code': '099' } } }];\n} else if (endpoint === 'accounts') {\n  responseBody = (failMode === 'acct') ? [] : [{ id: 3001, name: 'CWR-099-999-160999-OtherOperating', 'account-type': { name: 'Coastal Waste COA' } }];\n} else if (endpoint === 'suppliers') {\n  const dn = (q['display-name'] || '').toString();\n  responseBody = dn.includes('FAIL-SUPPLIER') ? [] : [{ id: 4001, 'display-name': 'Sandbox Contractor LLC' }];\n} else if (endpoint === 'createRequisition') {\n  if (failMode === 'createreq') { statusCode = 500; responseBody = { errors: { base: ['Mock create-requisition failure'] } }; }\n  else responseBody = { id: 424242, status: 'pending_approval', 'requisition-lines': [{ 'line-num': '1' }] };\n} else if (endpoint === 'requisitionAttachment') {\n  if (failMode === 'attachq') { statusCode = 500; responseBody = { errors: { base: ['Mock requisition-attachment failure'] } }; }\n  else responseBody = { id: 500001, type: 'file', file: 'attached' };\n} else if (endpoint === 'getRequisition') {\n  if (failMode === 'getreq') { statusCode = 500; responseBody = { errors: { base: ['Mock get-requisition failure'] } }; }\n  else if (failMode === 'reqpending') responseBody = { id: 424242, status: 'requisition_pending' };\n  else responseBody = { id: 424242, status: 'ordered' };\n} else if (endpoint === 'purchaseOrders') {\n  if (failMode === 'getpo') { statusCode = 500; responseBody = { errors: { base: ['Mock get-purchase_orders failure'] } }; }\n  else responseBody = [{ id: 555001, 'po-number': 'PO-555001', status: 'issued', 'requisition-header': { id: 424242 }, 'created-by': { fullname: 'Jordan Buyer' } }];\n} else if (endpoint === 'poAttachment') {\n  if (failMode === 'poattach') { statusCode = 500; responseBody = { errors: { base: ['Mock PO-attachment failure'] } }; }\n  else responseBody = { id: 500002, type: 'file' };\n} else if (endpoint === 'poComment') {\n  if (failMode === 'pocomment') { statusCode = 500; responseBody = { errors: { base: ['Mock PO-comment failure'] } }; }\n  else responseBody = { id: 600001, comments: 'posted' };\n} else {\n  statusCode = 500; responseBody = { errors: { base: ['Unknown mock endpoint: ' + endpoint] } };\n}\n\nreturn [{ json: { endpoint, failMode, statusCode, responseBody } }];"
      }
    },
